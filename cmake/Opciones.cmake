# Opciones de compilación comunes a todos los objetivos del proyecto (RNF-025).
function(refugio_configurar_objetivo objetivo)
    if(MSVC)
        target_compile_options(${objetivo} PRIVATE /W4 /permissive- /utf-8)
        if(REFUGIO_WARNINGS_AS_ERRORS)
            target_compile_options(${objetivo} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${objetivo} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion
                                                  -Wno-sign-conversion -ffp-contract=off)
        if(REFUGIO_WARNINGS_AS_ERRORS)
            target_compile_options(${objetivo} PRIVATE -Werror)
        endif()
        if(REFUGIO_SANITIZERS)
            target_compile_options(${objetivo} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
            target_link_options(${objetivo} PRIVATE -fsanitize=address,undefined)
        endif()
        if(REFUGIO_COVERAGE)
            target_compile_options(${objetivo} PRIVATE --coverage -O0 -g)
            target_link_options(${objetivo} PRIVATE --coverage)
        endif()
    endif()
endfunction()
